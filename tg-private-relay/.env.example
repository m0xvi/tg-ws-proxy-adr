# A dedicated subdomain whose A record points DIRECTLY to this VPS.
# If DNS is managed by Cloudflare, set the record to DNS only (grey cloud).
RELAY_DOMAIN=relay.example.com

# Generate with: openssl rand -hex 32
# Do not send this token to anyone and do not publish your .env file.
RELAY_TOKEN=replace-with-at-least-32-random-characters

MAX_CONNECTIONS=256
WS_READ_LIMIT_BYTES=2097152
